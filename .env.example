# ---------------------------------------------------------------------------
# JIRAMA Share — configuration. Copier en `.env` (jamais versionné).
# Sur o2switch, ces variables peuvent aussi être saisies dans « Setup Node.js App ».
# ---------------------------------------------------------------------------

NODE_ENV=production
APP_URL=https://jirama.gasycoder.com
# Port local (ignoré sous Phusion Passenger, qui fournit son propre socket).
PORT=3000
HOST=0.0.0.0
# Derrière le proxy d'o2switch : true pour obtenir la vraie IP et le protocole.
TRUST_PROXY=true
# Origines supplémentaires autorisées (séparées par des virgules), facultatif.
# CORS_ORIGINS=

# --- Base de données Supabase ------------------------------------------------
# Utiliser le POOLER Supavisor (IPv4) et non la connexion directe db.<ref>.supabase.co (IPv6 seulement).
# Dashboard Supabase → Connect → « Transaction pooler » (port 6543) ou « Session pooler » (port 5432).
# Exemple : postgresql://postgres.<project-ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Facultatif : URL utilisée par `npm run db:migrate` (recommandé : Session pooler, port 5432).
# MIGRATION_DATABASE_URL=
# auto (TLS sauf localhost) | require | verify-full | disable
DATABASE_SSL=auto
DATABASE_POOL_MAX=5

# Développement sans serveur PostgreSQL : base embarquée (migrée automatiquement au démarrage).
# DATABASE_URL=pglite:./.data/pglite

# --- Sessions ----------------------------------------------------------------
SESSION_TTL_DAYS=14
# Par défaut : cookie « Secure » en production. Forcer à false uniquement en local sans HTTPS.
# COOKIE_SECURE=true

# --- Stockage des photos (Supabase Storage, bucket PRIVÉ) ---------------------
STORAGE_DRIVER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Clé publique : non utilisée par le serveur (aucune clé n'est envoyée au navigateur).
SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT. Ne jamais l'exposer au frontend ni la versionner.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=jirama-share
UPLOAD_MAX_MB=10
# Développement : STORAGE_DRIVER=local et LOCAL_STORAGE_DIR=.data/uploads
# LOCAL_STORAGE_DIR=.data/uploads

# --- Lecture automatique des photos (facultatif) -------------------------------
# none : saisie manuelle + date EXIF. anthropic : lecture des chiffres par vision IA (Claude),
# toujours soumise à confirmation humaine.
EXTRACTOR_PROVIDER=none
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Journaux ----------------------------------------------------------------
LOG_LEVEL=info
# Écrire les journaux dans un fichier (sinon sortie standard, visible dans les logs Passenger).
# LOG_FILE=/home/<compte>/logs/jirama-share.log
RATE_LIMIT_MAX=300

# --- Seed de démonstration (facultatif) ---------------------------------------
# SEED_ADMIN_EMAIL=admin@exemple.mg
# SEED_ADMIN_PASSWORD=
